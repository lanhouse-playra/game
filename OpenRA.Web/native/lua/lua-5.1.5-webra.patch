+/*
+** WebRA: glibc's strtoul/strtoull read "0x" without hex digits after it as "0" and stop before the
+** "x"; musl consumes the prefix. Reproduce glibc (desktop Linux), and parse in 64 bits as on LP64.
+*/
+LUAI_FUNC unsigned long long luaO_webra_strtoull (const char *s, char **endptr, int base) {
+  const char *p = s;
+  while (isspace(cast(unsigned char, *p))) p++;
+  if (*p == '+' || *p == '-') p++;
+  if ((base == 16 || base == 0) && p[0] == '0' && (p[1] == 'x' || p[1] == 'X') &&
+      !isxdigit(cast(unsigned char, p[2]))) {
+    if (endptr) *endptr = (char *)(p + 1);
+    return 0;
+  }
+  return strtoull(s, endptr, base);
+}
+
