+/*
+** WebRA: the sign of a NaN shows in tostring ("nan" or "-nan"), so reproduce glibc (desktop Linux):
+** a NaN argument comes back unchanged (musl's sinh and cosh clear its sign), and the domain errors
+** of asin, acos, log and log10 (asin(2), log(-1)) give a positive NaN (musl computes 0/0, which is
+** a negative NaN on x86).
+*/
+static lua_Number webra_nan_arg (lua_Number x, lua_Number r) {
+  return (x != x) ? x : r;
+}
+
+static lua_Number webra_domain_nan (lua_Number x, lua_Number r) {
+  if (x != x) return x;
+  if (r != r) return fabs(r);
+  return r;
+}
+
