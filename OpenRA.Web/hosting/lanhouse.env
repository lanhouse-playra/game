# Lanhouse: the page at https://play.lanhouse.app/webra/ (Cloudflare R2 behind Cloudflare, T-2450), the
# relay on the games VM behind the bunker's Caddy (wss://<games host>/<game>/<server slug>/<port name>,
# 612 modules/bunker/HOSTING.md 1.2). Names and paths are provisional: change them here (or override any
# line from the environment) and rebuild. The base path is not part of the build: the page finds its
# files relative to itself, so the publisher picks it (publish.json lists keys under the base).
# Build: WEBRA_TARGET=lanhouse WEBRA_AOT=1 ./build-web.sh

# Game connections: the relay's "ws" port.
WEBRA_PROXY_URL=wss://games.lanhouse.app/openra/relay/ws
# versioncheck and gamenews: the relay's "master" port (the relay runs with -master-cors and
# -origins https://play.lanhouse.app).
WEBRA_MASTER_RELAY=https://games.lanhouse.app/openra/relay/master
# The Red Alert content package from our own site: <base>/content/ra-quickinstall.<sha1>.zip, written by
# tools/fetch-content.py and uploaded with the build. The relay's content route is not used.
WEBRA_CONTENT_URL=content
# R2 cannot send headers; the policy is in the page too (Cloudflare adds the header and frame-ancestors).
WEBRA_META_CSP=1
WEBRA_PUBLISH_ENCODING=br
