<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
	<!--
		Browser (WebAssembly) host for OpenRA. Built by build-web.sh, which first produces the native
		inputs below ($(PlayraNativeDir)) and the Eluant build with WebAssembly callback markers
		($(PlayraEluantPath)) and the generated GL delegate signatures ($(PlayraGeneratedDir)).
	-->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<RootNamespace>OpenRA.Web</RootNamespace>
		<TargetPlatform>browser-wasm</TargetPlatform>
		<OutputPath>$(MSBuildProjectDirectory)/bin/$(Configuration)/</OutputPath>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<Nullable>disable</Nullable>

		<!-- OpenRA loads traits, widgets and mod assemblies through reflection. -->
		<PublishTrimmed>false</PublishTrimmed>
		<!-- OpenRA creates CultureInfo objects for its Fluent translations. -->
		<InvariantGlobalization>false</InvariantGlobalization>
		<UseSystemResourceKeys>false</UseSystemResourceKeys>
		<WasmEnableThreads>false</WasmEnableThreads>

		<!--
			OpenRA reads HTTP responses with synchronous Stream.Read calls (map details and map downloads
			from the resource center). The browser HttpClient's streaming responses only support async
			reads; buffered responses (the whole body is fetched before the content is returned) support both.
		-->
		<WasmEnableStreamingResponse>false</WasmEnableStreamingResponse>

		<!-- Native build: link emscripten's SDL2, FreeType, OpenAL and WebGL 2 plus our Lua and GL shim. -->
		<WasmBuildNative>true</WasmBuildNative>
		<WasmCachePath Condition="'$(PlayraEmCache)' != ''">$(PlayraEmCache)</WasmCachePath>
		<EmccInitialHeapSize>268435456</EmccInitialHeapSize>
		<EmccMaximumHeapSize>2147483648</EmccMaximumHeapSize>
		<EmccExtraLDFlags>-sUSE_SDL=2 -sUSE_FREETYPE=1 -lopenal -sMIN_WEBGL_VERSION=2 -sMAX_WEBGL_VERSION=2 -sFULL_ES3=1 -sGL_ENABLE_GET_PROC_ADDRESS=1 -sSUPPORT_LONGJMP=wasm</EmccExtraLDFlags>

		<!--
			SDL2-CS binds every SDL entry point, including platform-specific ones (Android, WinRT, ...) that
			emscripten's SDL2 does not have. Those become JS stubs that abort if called; the link log lists
			them as "undefined symbol" warnings. OpenRA only calls portable SDL functions.
		-->
		<WasmAllowUndefinedSymbols>true</WasmAllowUndefinedSymbols>

		<!-- Writes dotnet.native.js.symbols (function index to name) to symbolicate wasm stack traces. -->
		<WasmEmitSymbolMap>true</WasmEmitSymbolMap>

		<RunAOTCompilation Condition="'$(RunAOTCompilation)' == ''">false</RunAOTCompilation>
	</PropertyGroup>

	<!--
		Mono AOT requires IL trimming. Partial trimming only trims assemblies marked as trimmable (the
		framework); OpenRA's own assemblies stay whole for their reflection-based loading.
	-->
	<PropertyGroup Condition="'$(RunAOTCompilation)' == 'true'">
		<PublishTrimmed>true</PublishTrimmed>
		<TrimMode>partial</TrimMode>
		<SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
	</PropertyGroup>

	<!--
		Libraries the browser build does not use, compiled to WebAssembly for nothing: they are left to the
		interpreter (which would run them if they were ever called), so the native module carries no code for
		them. Newtonsoft.Json and DiscordRPC (Discord rich presence, which a browser cannot reach), with what
		only Newtonsoft.Json keeps (System.Private.Xml, System.Data.Common, Microsoft.CSharp, ...); TagLibSharp
		(MP3 tags; Red Alert has no MP3); Mono.Nat (UPnP) and BeaconLib (LAN game discovery), which need sockets.
		None of them ran in a recorded session (aot/playra.aotprofile). The SDK's item for "do not AOT".
	-->
	<ItemGroup Condition="'$(RunAOTCompilation)' == 'true'">
		<_AOT_InternalForceInterpretAssemblies Include="Newtonsoft.Json.dll;DiscordRPC.dll;System.Private.Xml.dll;System.Private.Xml.Linq.dll;System.Data.Common.dll;System.Runtime.Serialization.Formatters.dll;Microsoft.CSharp.dll;TagLibSharp.dll;Mono.Nat.dll;BeaconLib.dll" />
	</ItemGroup>

	<!--
		Generic instances found at run time. The AOT compiler compiles the generic instances it sees in the code;
		others (instances made by shared generic code at run time, value types as type arguments across assemblies)
		ran in Mono's interpreter, about a tenth of the main thread in a match. aot/playra.aotprofile, recorded
		with Mono's AOT profiler in a dev build (aot/AotProfileRecorder.cs), lists every method a session ran, and the
		compiler adds the generic instances in it (Mono's "profile" option, without "profile-only": everything else
		is compiled as before).
	-->
	<ItemGroup Condition="'$(RunAOTCompilation)' == 'true' and '$(PlayraAotProfiler)' != 'true' and Exists('$(MSBuildProjectDirectory)/aot/playra.aotprofile')">
		<MonoAOTCompilerDefaultAotArguments Include="profile=$(MSBuildProjectDirectory)/aot/playra.aotprofile" />
	</ItemGroup>

	<!-- Dev builds with PLAYRA_AOT_PROFILER=1 (build-web.sh) link Mono's AOT profiler and the recorder that saves its data. -->
	<PropertyGroup Condition="'$(PlayraAotProfiler)' == 'true'">
		<WasmProfilers>aot</WasmProfilers>
	</PropertyGroup>
	<ItemGroup Condition="'$(PlayraAotProfiler)' != 'true'">
		<Compile Remove="aot/**" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\OpenRA.Game\OpenRA.Game.csproj" />
		<ProjectReference Include="..\OpenRA.Platforms.Default\OpenRA.Platforms.Default.csproj" />
		<ProjectReference Include="..\OpenRA.Mods.Common\OpenRA.Mods.Common.csproj" />
		<ProjectReference Include="..\OpenRA.Mods.Cnc\OpenRA.Mods.Cnc.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- C sources and the Eluant addition are built by build-web.sh, not by this project. -->
		<Compile Remove="native/**" />
		<!-- The conformance corpus is shared with its desktop runner (conformance/desktop). -->
		<Compile Remove="conformance/**" />
		<Compile Include="conformance/ConformanceCorpus.cs" />
	</ItemGroup>

	<ItemGroup Condition="'$(PlayraGeneratedDir)' != ''">
		<Compile Include="$(PlayraGeneratedDir)GLSignatures.g.cs" />
		<Compile Include="$(PlayraGeneratedDir)PlayraBuildInfo.g.cs" />
	</ItemGroup>

	<ItemGroup Condition="'$(PlayraNativeDir)' != ''">
		<NativeFileReference Include="$(PlayraNativeDir)lua51.a" />
		<NativeFileReference Include="$(PlayraNativeDir)playra.a" />
		<NativeFileReference Include="$(PlayraNativeDir)SDL2.a" />
		<NativeFileReference Include="$(PlayraNativeDir)freetype6.a" />
		<NativeFileReference Include="$(PlayraNativeDir)soft_oal.a" />
	</ItemGroup>

	<!--
		Directory.Build.props removes every analyzer in Release builds to save compile time. That would
		also remove the source generator behind [JSExport], so this project only drops the style analyzers.
	-->
	<Target Name="DisableAnalyzers" BeforeTargets="CoreCompile" Condition="'$(Configuration)'=='Release'">
		<ItemGroup>
			<Analyzer Remove="@(Analyzer)" Condition="$([System.String]::Copy('%(Filename)').StartsWith('StyleCop')) or $([System.String]::Copy('%(Filename)').StartsWith('Roslynator'))" />
		</ItemGroup>
	</Target>

	<!--
		Swap the packaged Eluant.dll for the same upstream source built with its MonoPInvokeCallback
		markers enabled (see native/eluant/MonoPInvokeCallbackAttribute.cs). The API is identical.
	-->
	<Target Name="PlayraUseWasmEluant" AfterTargets="ResolvePackageAssets" Condition="'$(PlayraEluantPath)' != ''">
		<Error Condition="!Exists('$(PlayraEluantPath)')" Text="PlayraEluantPath does not exist: $(PlayraEluantPath)" />
		<ItemGroup>
			<_PlayraPackagedEluant Include="@(RuntimeCopyLocalItems)" Condition="'%(Filename)%(Extension)' == 'Eluant.dll'" />
			<RuntimeCopyLocalItems Remove="@(_PlayraPackagedEluant)" />
			<RuntimeCopyLocalItems Include="$(PlayraEluantPath)" NuGetPackageId="OpenRA-Eluant" NuGetPackageVersion="wasm" AssetType="runtime" CopyLocal="true" DestinationSubPath="Eluant.dll" />
		</ItemGroup>
	</Target>
</Project>
